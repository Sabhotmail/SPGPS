# Database — ชี้ไปที่ PostgreSQL ของคุณ (local หรือ remote)
DATABASE_URL=postgresql://spgps:spgps_secret@localhost:5432/spgps

# Scalefusion
SCALEFUSION_API_KEY=your_api_key_here
SCALEFUSION_BASE_URL=https://api.scalefusion.com
# Official limit: 30 req/min, 43200/day — default near ceiling for faster backfill
SCALEFUSION_MAX_RPM=28
SCALEFUSION_MIN_GAP_MS=2100

# Auth
AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
AUTH_TRUST_HOST=true
# Web server port (default 3000). Change for production if needed.
PORT=3000
# Leave AUTH_URL / NEXTAUTH_URL unset so Auth.js follows the browser Host
# (localhost AND Tailscale IP both work). Setting them to localhost causes
# redirects back to localhost when opening via Tailscale.
# AUTH_URL=http://100.x.x.x:3000
# NEXTAUTH_URL=http://100.x.x.x:3000

# Password reset via Microsoft 365 / Outlook SMTP
# Enable SMTP AUTH for the mailbox (or use an app password if MFA is on).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASS=your-mailbox-password-or-app-password
SMTP_FROM=SPGPS <noreply@yourcompany.com>

# Worker — choose ONE mode:
# 1) Interval (default): every 3 minutes
POLL_INTERVAL_MS=180000
# 2) Fixed times (uncomment to use schedule instead of interval)
# POLL_SCHEDULE=08:00,12:00,17:00,21:00
# POLL_TZ=Asia/Bangkok
# POLL_ON_STARTUP=1

# Catch-up: re-fetch locations.json for recent days so tracks aren't sparse
# between geofence polls. Default on, hourly, today only.
# POLL_CATCHUP_ENABLED=1
# POLL_CATCHUP_INTERVAL_MS=3600000
# POLL_CATCHUP_DAYS=1

# Seed
SEED_ADMIN_EMAIL=admin@spgps.local
SEED_ADMIN_PASSWORD=admin123

# Daily GPS grouping (history, calendar, backfill day boundaries)
APP_TIMEZONE=Asia/Bangkok
NEXT_PUBLIC_APP_TIMEZONE=Asia/Bangkok

# Optional map tiles (default: OpenStreetMap — no API key)
# Carto light tiles now require a key; leave unset unless you have your own provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap
